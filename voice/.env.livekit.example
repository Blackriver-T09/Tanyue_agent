# Local self-hosted LiveKit server
# Start it with: cd LiveKit && docker compose up
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# Aliyun Bailian / DashScope
# You can also keep the key in project-level Config.py as API_KEY.
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_WORKSPACE_ID=your-workspace-id
DASHSCOPE_REGION=beijing

# Online Aliyun realtime STT / ASR
TANYUE_STT_PROVIDER=aliyun
TANYUE_ALIYUN_STT_MODEL=fun-asr-realtime
TANYUE_STT_LANGUAGE=zh
TANYUE_ALIYUN_STT_SILENCE_MS=400
TANYUE_ALIYUN_STT_PUNCTUATION=0
TANYUE_ALIYUN_STT_NOISE_GATE_ENABLED=1
TANYUE_ALIYUN_STT_NOISE_GATE_DBFS=-45
TANYUE_ALIYUN_STT_NOISE_GATE_OPEN_MS=80
TANYUE_ALIYUN_STT_NOISE_GATE_HANGOVER_MS=900
TANYUE_ALIYUN_STT_NOISE_GATE_SEND_SILENCE=1
TANYUE_ALIYUN_STT_NOISE_GATE_LOG_INTERVAL_S=5

# Online Qwen through DashScope OpenAI-compatible API
TANYUE_QWEN_MODEL=qwen3.6-flash
TANYUE_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TANYUE_QWEN_ENABLE_THINKING=0
TANYUE_QWEN_MAX_COMPLETION_TOKENS=48
TANYUE_QWEN_TEMPERATURE=0.6

# Online Aliyun CosyVoice TTS
TANYUE_COSYVOICE_MODEL=cosyvoice-v3.5-plus
TANYUE_COSYVOICE_VOICE=longxiaochun
TANYUE_COSYVOICE_INSTRUCTION=
TANYUE_COSYVOICE_ENABLE_STYLE_PARAMS=0
TANYUE_COSYVOICE_CLONE_ENABLED=1
TANYUE_COSYVOICE_REFERENCE_AUDIO=voice/reference.wav
TANYUE_COSYVOICE_CLONE_PREFIX=tanyue
TANYUE_COSYVOICE_CLONE_CACHE=voice/.cosyvoice_voice_id
TANYUE_COSYVOICE_CLONE_MAX_SECONDS=20
TANYUE_COSYVOICE_VOICE_REGISTRY=voice/cosyvoice_voices.json
TANYUE_COSYVOICE_RANDOM_VOICE_ENABLED=1

# LiveKit agent identity
TANYUE_LIVEKIT_AGENT_NAME=tanyue

# Interruption guard. Keep interruption enabled, but ignore very short echo-like
# fragments such as "嗯" while the assistant is speaking.
TANYUE_ALLOW_INTERRUPTION=1
TANYUE_MIN_INTERRUPTION_DURATION=0.65
TANYUE_MIN_INTERRUPTION_WORDS=2
TANYUE_FALSE_INTERRUPTION_TIMEOUT=1.2
TANYUE_RESUME_FALSE_INTERRUPTION=1
TANYUE_AGENT_FALSE_INTERRUPTION_TIMEOUT=1.0

# Character bridge. The voice agent will ask Qwen to choose a motion id from
# character/motions/manifest.json, then POST that motion to this bridge while
# speaking the reply.
TANYUE_CHARACTER_ENABLED=1
TANYUE_CHARACTER_BRIDGE_URL=http://127.0.0.1:8893
TANYUE_CHARACTER_BRIDGE_TIMEOUT=0.35
