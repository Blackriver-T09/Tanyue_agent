# Local self-hosted LiveKit server
# Start it with: cd LiveKit && docker compose up
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# Aliyun Bailian / DashScope
# You can also keep the key in project-level Config.py as API_KEY.
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_WORKSPACE_ID=your-workspace-id
DASHSCOPE_REGION=beijing

# Online Aliyun realtime STT / ASR
TANYUE_STT_PROVIDER=aliyun
TANYUE_ALIYUN_STT_MODEL=fun-asr-realtime
TANYUE_STT_LANGUAGE=zh
TANYUE_ALIYUN_STT_SILENCE_MS=400
TANYUE_ALIYUN_STT_PUNCTUATION=0

# Online Qwen through DashScope OpenAI-compatible API
TANYUE_QWEN_MODEL=qwen3.6-flash
TANYUE_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TANYUE_QWEN_ENABLE_THINKING=0
TANYUE_QWEN_MAX_COMPLETION_TOKENS=48
TANYUE_QWEN_TEMPERATURE=0.6

# Online Aliyun CosyVoice TTS
TANYUE_COSYVOICE_MODEL=cosyvoice-v1
TANYUE_COSYVOICE_VOICE=longxiaochun
TANYUE_COSYVOICE_INSTRUCTION=温柔、亲近、自然地说话
TANYUE_COSYVOICE_ENABLE_STYLE_PARAMS=0

# LiveKit agent identity
TANYUE_LIVEKIT_AGENT_NAME=tanyue
